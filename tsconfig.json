{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    // Type-check and tests read sibling packages from source, so nothing needs building first.
    // Package builds clear these and resolve each other's dist through node_modules.
    "paths": {
      "@mayan-numerals/core": ["./packages/@mayan-numerals/core/src/index.ts"],
      "@mayan-numerals/raster": ["./packages/@mayan-numerals/raster/src/index.ts"]
    }
  },
  "include": ["packages/*/*/src", "packages/*/*/test", "vitest.config.ts"]
}
